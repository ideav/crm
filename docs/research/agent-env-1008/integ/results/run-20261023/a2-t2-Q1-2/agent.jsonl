{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UQHGVhyzfkmR3hLvnP7rgc","type":"tool_result","content":[{"type":"text","text":"1|Д-001|21006|1500000|2026-10-01|Подписан|7700001009|1500000\n2|Д-002|21030|3000000||Проект|7700003027|3000000\n SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n"}]}]},"parent_tool_use_id":null,"session_id":"96ffd4de-581e-41ee-8f50-93e1ded20904","uuid":"eec0e887-b725-4ea1-a7af-0be92ccea30f","timestamp":"2026-10-22T22:01:18.414Z","tool_use_result":[{"type":"text","text":"1|Д-001|21006|1500000|2026-10-01|Подписан|7700001009|1500000\n2|Д-002|21030|3000000||Проект|7700003027|3000000\n SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n"}],"tool_result_meta":[{"id":"toolu_01UQHGVhyzfkmR3hLvnP7rgc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
