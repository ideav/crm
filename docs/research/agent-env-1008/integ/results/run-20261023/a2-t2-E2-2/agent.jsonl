{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gb99qMPidyKL1LVpmQh8M5","type":"tool_result","content":[{"type":"text","text":" SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n SELECT inn,\n    legal_name AS name,\n    funding_limit\n   FROM reg.counterparty;\n7700001009|ООО «Альфа»|5000000\n7700002018|ООО «Бета»|3000000\n7700003027|АО «Гамма»|8000000\n"}]}]},"parent_tool_use_id":null,"session_id":"9689de37-6448-4808-86cc-3632dd0ed86c","uuid":"1ebb7779-eb69-48f5-a4f6-09c2b9618bc4","timestamp":"2026-10-22T22:02:37.471Z","tool_use_result":[{"type":"text","text":" SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n SELECT inn,\n    legal_name AS name,\n    funding_limit\n   FROM reg.counterparty;\n7700001009|ООО «Альфа»|5000000\n7700002018|ООО «Бета»|3000000\n7700003027|АО «Гамма»|8000000\n"}],"tool_result_meta":[{"id":"toolu_01Gb99qMPidyKL1LVpmQh8M5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
