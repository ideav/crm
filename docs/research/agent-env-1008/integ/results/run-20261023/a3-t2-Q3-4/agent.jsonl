{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019mRN14xtiUat4xFnaE7xrn","type":"tool_result","content":[{"type":"text","text":" SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}]}]},"parent_tool_use_id":null,"session_id":"6a1a92b5-c949-4a31-9eab-40e8bf7bc9a4","uuid":"15fbd17f-f52f-495b-9ebb-eed53e421ec5","timestamp":"2026-10-22T23:26:30.774Z","tool_use_result":[{"type":"text","text":" SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}],"tool_result_meta":[{"id":"toolu_019mRN14xtiUat4xFnaE7xrn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
