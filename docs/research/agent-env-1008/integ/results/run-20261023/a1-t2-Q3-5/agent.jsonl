{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y79m1Y9gEFdzhcNAzJJAeB","type":"tool_result","content":[{"type":"text","text":"id|application\nnumber|application\ncompany_id|application\nstatus_id|application\namount|application\nrevenue|application\ndescription|application\nexpert|application\nverdict|application\nid|status\nname|status\nord|status\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}]}]},"parent_tool_use_id":null,"session_id":"aaa5a5b5-a845-4909-86d1-3a2b2b619d2c","uuid":"4093f147-d7f5-4c34-af70-5df8a73e3553","timestamp":"2026-10-22T21:47:44.045Z","tool_use_result":[{"type":"text","text":"id|application\nnumber|application\ncompany_id|application\nstatus_id|application\namount|application\nrevenue|application\ndescription|application\nexpert|application\nverdict|application\nid|status\nname|status\nord|status\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}],"tool_result_meta":[{"id":"toolu_01Y79m1Y9gEFdzhcNAzJJAeB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
