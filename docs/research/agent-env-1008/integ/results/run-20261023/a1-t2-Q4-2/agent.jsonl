{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XES7wACL4xQ9ptFAvJpkf1","type":"tool_result","content":[{"type":"text","text":"ООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n20005|ООО «Альфа»|5000000\n20008|ООО «Бета»|3000000\n20011|АО «Гамма»|8000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}]}]},"parent_tool_use_id":null,"session_id":"7af3d146-3753-4620-b673-cf0eee600aba","uuid":"ce563bd0-f463-43e5-84fd-5657d367b57d","timestamp":"2026-10-22T21:37:50.309Z","tool_use_result":[{"type":"text","text":"ООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n20005|ООО «Альфа»|5000000\n20008|ООО «Бета»|3000000\n20011|АО «Гамма»|8000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}],"tool_result_meta":[{"id":"toolu_01XES7wACL4xQ9ptFAvJpkf1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
