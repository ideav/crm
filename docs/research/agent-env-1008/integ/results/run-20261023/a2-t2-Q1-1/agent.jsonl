{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013kQgQ6SrSfX49fkU7B4AGE","type":"tool_result","content":[{"type":"text","text":"ООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n7700001009|ООО «Альфа»|5000000\n7700002018|ООО «Бета»|3000000\n7700003027|АО «Гамма»|8000000\n SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n"}]}]},"parent_tool_use_id":null,"session_id":"0315ad7e-f0fb-42a6-8994-89b4a5f532b6","uuid":"94e0b206-f145-4afd-bd03-2aed41dabba3","timestamp":"2026-10-22T21:57:42.359Z","tool_use_result":[{"type":"text","text":"ООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n7700001009|ООО «Альфа»|5000000\n7700002018|ООО «Бета»|3000000\n7700003027|АО «Гамма»|8000000\n SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\n"}],"tool_result_meta":[{"id":"toolu_013kQgQ6SrSfX49fkU7B4AGE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
