{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HmEPLZdSeEkWrJugbiw9a2","type":"tool_result","content":[{"type":"text","text":" SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\nООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n"}]}]},"parent_tool_use_id":null,"session_id":"d1754230-95d6-4791-80ad-4d31d0ace37f","uuid":"add22e0a-bdca-449f-a867-87a212e99d10","timestamp":"2026-10-22T22:13:23.214Z","tool_use_result":[{"type":"text","text":" SELECT r.legal_name AS company,\n    r.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (r.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((reg.counterparty r\n     LEFT JOIN ( SELECT application.company_inn,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_inn) ap ON ((ap.company_inn = r.inn)))\n     LEFT JOIN ( SELECT a.company_inn,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_inn) k ON ((k.company_inn = r.inn)));\nООО «Альфа»|5000000|2500000|1500000|3500000\nООО «Бета»|3000000|2000000|0|3000000\nАО «Гамма»|8000000|3000000|3000000|5000000\n"}],"tool_result_meta":[{"id":"toolu_01HmEPLZdSeEkWrJugbiw9a2","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
