{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0118A5Pns4G7YAtwMofmnFqT","type":"tool_result","content":[{"type":"text","text":"ООО «Бета»|3000000|2000000|0|3000000\nООО «Альфа»|5000000|2500000|1500000|3500000\nАО «Гамма»|8000000|3000000|3000000|5000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n20005|ООО «Альфа»|7700001009|5000000|58009517-9772-57c0-8c12-180dc192012c\n20008|ООО «Бета»|7700002018|3000000|0221ab04-86e6-5a00-8275-e75cc0af4ebe\n20011|АО «Гамма»|7700003027|8000000|b7da7363-223d-57d3-b23b-1e939f613502\n"}]}]},"parent_tool_use_id":null,"session_id":"2ddbd8f4-6bf7-4fdf-87a9-ab54cecc1216","uuid":"b07cfa79-d23e-4e32-9a91-fdee62bbef6f","timestamp":"2026-10-22T23:20:29.866Z","tool_use_result":[{"type":"text","text":"ООО «Бета»|3000000|2000000|0|3000000\nООО «Альфа»|5000000|2500000|1500000|3500000\nАО «Гамма»|8000000|3000000|3000000|5000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n 