{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XAFJXTQQ6tqTuBVUi3ZpmY","type":"tool_result","content":[{"type":"text","text":"id\nnumber\ncompany_id\nstatus_id\namount\nrevenue\ndescription\nexpert\nverdict\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}]}]},"parent_tool_use_id":null,"session_id":"6d744723-1999-432f-9591-808774255ed0","uuid":"3c674426-c8d8-459b-9317-f3efae352b2f","timestamp":"2026-10-22T21:41:01.843Z","tool_use_result":[{"type":"text","text":"id\nnumber\ncompany_id\nstatus_id\namount\nrevenue\ndescription\nexpert\nverdict\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n"}],"tool_result_meta":[{"id":"toolu_01XAFJXTQQ6tqTuBVUi3ZpmY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
