{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015HdELLAWnSyfxwYGUpny3h","type":"tool_result","content":[{"type":"text","text":"id|integer||not null|nextval('api.application_id_seq'::regclass)\nnumber|text||not null|\ncompany_id|integer||not null|\nstatus_id|integer||not null|\namount|numeric||not null|\nrevenue|numeric|||\ndescription|text|||\nexpert|text|||\nverdict|text|||\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n20000|Черновик|1\n20001|Подана|2\n20002|На экспертизе|3\n20003|Одобрена|4\n20004|Отклонена|5\n"}]}]},"parent_tool_use_id":null,"session_id":"3a297c1e-b261-4e6c-a471-a1d071ef294e","uuid":"5f801a3f-d8ec-4b47-8e81-d291b2b8fac4","timestamp":"2026-10-22T21:33:54.980Z","tool_use_result":[{"type":"text","text":"id|integer||not null|nextval('api.application_id_seq'::regclass)\nnumber|text||not null|\ncompany_id|integer||not null|\nstatus_id|integer||not null|\namount|numeric||not null|\nrevenue|numeric|||\ndescription|text|||\nexpert|text|||\nverdict|text|||\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\n20000|Черновик|1\n20001|Подана|2\n20002|На экспертизе|3\n20003|Одобрена|4\n20004|Отклонена|5\n"}],"tool_result_meta":[{"id":"toolu_015HdELLAWnSyfxwYGUpny3h","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
