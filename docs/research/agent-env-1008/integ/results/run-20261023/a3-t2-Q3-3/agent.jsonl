{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NT1VpBMYJtnKKi78KjTWnv","type":"tool_result","content":[{"type":"text","text":" SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\nАО «Гамма»|На экспертизе|1|2100000\nАО «Гамма»|Одобрена|1|3000000\nАО «Гамма»|Подана|1|3900000\nАО «Гамма»|Черновик|1|4700000\nООО «Альфа»|На экспертизе|1|5000000\nООО «Альфа»|Одобрена|2|2500000\nООО «Альфа»|Подана|1|2600000\nООО «Альфа»|Черновик|1|3800000\nООО «Бета»|На экспертизе|1|4200000\nООО «Бета»|Одобрена|1|2000000\nООО «Бета»|Отклонена|1|800000\nООО «Бета»|Подана|1|4800000\nООО «Бета»|Черновик|1|800000\n1|Д-001|21006|1500000|2026-10-01|Подписан\n2|Д-002|21030|3000000||Проект\n"}]}]},"parent_tool_use_id":null,"session_id":"3ca569b8-dccb-4d31-a909-1ebf3f190e1f","uuid":"7e48f1f0-61ca-40ee-a3f7-41d8afb67cdc","timestamp":"2026-10-22T23:23:33.054Z","tool_use_result":[{"type":"text","text":" SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\nАО «Гамма»|На экспертизе|1|2100000\nАО «Гамма»|Одобрена|1|3000000\nАО «Гамма»|Подана|1|3900000\nАО «Гамма»|Черновик|1|4700000\nООО «Альфа»|На экспертизе|1|5000000\nООО «Альфа»|Одобрена|2|2500000\nООО «Альфа»|Подана|1|2600000\nООО «Альфа»|Черновик|1|3800000\nООО «Бета»|На экспертизе|1|4200000\nООО «Бета»|Одобрена|1|2000000\nООО «Бета»|Отклонена|1|800000\nООО «Бета»|Подана|1|4800000\nООО «Бета»|Черновик|1|800000\n1|Д-001|21006|1500000|2026-10-01|Подписан\n2|Д-002|21030|3000000||Проект\n"}],"tool_result_meta":[{"id":"toolu_01NT1VpBMYJtnKKi78KjTWnv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
