{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LH5XtE3TQu9eLKcF5GUi7Z","type":"tool_result","content":[{"type":"text","text":"20005|ООО «Альфа»|7700001009|5000000\n20008|ООО «Бета»|7700002018|3000000\n20011|АО «Гамма»|7700003027|8000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\napi|company|name\napi|status|name\napi|limit_balance|company\ncheck_process|api.application\naudit|api.application\ncheck_contract|api.contract\n"}]}]},"parent_tool_use_id":null,"session_id":"b53001df-b4b3-4af7-a3d5-fd37ed2aa01b","uuid":"0aa9708b-d73b-4171-b64b-54a75aa5a1dc","timestamp":"2026-10-22T21:38:19.303Z","tool_use_result":[{"type":"text","text":"20005|ООО «Альфа»|7700001009|5000000\n20008|ООО «Бета»|7700002018|3000000\n20011|АО «Гамма»|7700003027|8000000\n SELECT c.name AS company,\n    c.funding_limit,\n    COALESCE(ap.approved, (0)::numeric) AS approved,\n    COALESCE(k.contracted, (0)::numeric) AS contracted,\n    (c.funding_limit - COALESCE(k.contracted, (0)::numeric)) AS remaining\n   FROM ((api.company c\n     LEFT JOIN ( SELECT application.company_id,\n            sum(application.amount) AS approved\n           FROM api.application\n          WHERE (application.status_id = priv.status_id('Одобрена'::text))\n          GROUP BY application.company_id) ap ON ((ap.company_id = c.id)))\n     LEFT JOIN ( SELECT a.company_id,\n            sum(k_1.amount) AS contracted\n           FROM (api.contract k_1\n             JOIN api.application a ON ((a.id = k_1.application_id)))\n          GROUP BY a.company_id) k ON ((k.company_id = c.id)));\napi|company|name\napi|status|name\napi|limit_balance|company\ncheck_process|api.application\naudit|api.application\ncheck_contract|api.contract\n"}],"tool_result_meta":[{"id":"toolu_01LH5XtE3TQu9eLKcF5GUi7Z","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
