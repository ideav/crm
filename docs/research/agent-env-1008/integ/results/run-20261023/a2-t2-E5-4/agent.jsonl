{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017gcrrhzJEJg48JSLfGBHSE","type":"tool_result","content":[{"type":"text","text":"CREATE OR REPLACE FUNCTION priv.check_contract()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'api'\nAS $function$\nBEGIN\n    IF (SELECT status_id FROM api.application WHERE id = NEW.application_id) IS DISTINCT FROM priv.status_id('Одобрена') THEN\n        RAISE EXCEPTION 'договор оформляется только по одобренной заявке' USING ERRCODE = 'check_violation';\n    END IF;\n    RETURN NEW;\nEND $function$\n\nid\nnumber\napplication_id\namount\nsigned_on\nstatus\n"}]}]},"parent_tool_use_id":null,"session_id":"baac132f-319a-43db-bf8b-a896f8213f3a","uuid":"ea46c12a-b5d2-4f1d-a77e-9201c57290a4","timestamp":"2026-10-22T22:11:52.761Z","tool_use_result":[{"type":"text","text":"CREATE OR REPLACE FUNCTION priv.check_contract()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'api'\nAS $function$\nBEGIN\n    IF (SELECT status_id FROM api.application WHERE id = NEW.application_id) IS DISTINCT FROM priv.status_id('Одобрена') THEN\n        RAISE EXCEPTION 'договор оформляется только по одобренной заявке' USING ERRCODE = 'check_violation';\n    END IF;\n    RETURN NEW;\nEND $function$\n\nid\nnumber\napplication_id\namount\nsigned_on\nstatus\n"}],"tool_result_meta":[{"id":"toolu_017gcrrhzJEJg48JSLfGBHSE","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
