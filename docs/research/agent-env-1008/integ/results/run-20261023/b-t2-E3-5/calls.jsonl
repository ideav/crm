{"ts": 1792708066.918, "ms": 35, "tool": "api", "args": {"method": "GET", "path": "object/10200/?JSON_OBJ"}, "error": false, "out": "HTTP 200\n[{\"i\":20080,\"u\":1,\"o\":1,\"r\":[\"З-001\",\"20005:ООО «Альфа»\",\"20000:Черновик\",\"3800000\",\"38000000\",\"Проект 1: модернизация производства\",\"\",\"\"]},{\"i\":20086,\"u\":1,\"o\":2,\"r\":[\"З-002\",\"20005:ООО «Альфа»\",\"20001:Подана\",\"2600000\",\"10400000\",\"Проект 2: модернизация производства\",\"\",\"\"]},{\"i\":20092,\"u\":1,\"o\":3,\"r\":[\"З-003\",\"20005:ООО «Альфа»\",\"20002:На экспертизе\",\"5000000\",\"20000000\",\"Проект 3: модернизация производства\",\"20068:expert1\",\"\"]},{\"i\":20099,\"u\":1,\"o\":4,\"r\":[\"З-004\",\"20008:ООО «Бета»\",\"20000:Черновик\",\"800000\",\"4000000\",\"Проект 4: модернизация производства\",\"\",\"\"]},{\"i\":20105,\"u\":1,\"o\":5,\"r\":[\"З-005\",\"20008:ООО «Бета»\",\"20001:Подана\",\"4800000\",\"19200000\",\"Проект 5: модернизация производства\",\"\",\"\"]},{\"i\":20111,\"u\":1,\"o\":6,\"r\":[\"З-006\",\"20008:ООО «Бета»\",\"20002:На экспертизе\",\"4200000\",\"33600000\",\"Проект 6: модернизация производства\",\"20068:expert1\",\"\"]},{\"i\":20118,\"u\":1,\"o\":7,\"r\":[\"З-007\",\"20011:АО «Гамма»\",\"20000:Черновик\",\"4700000\",\"14100000\",\"Проект 7: модернизация производства\",\"\",\"\"]},{\"i\":20124,\"u\":1,\"o\":8,\"r\":[\"З-008\",\"20011:АО «Гамма»\",\"20001:Подана\",\"3900000\",\"31200000\",\"Проект 8: модернизация производства\",\"\",\"\"]},{\"i\":20130,\"u\":1,\"o\":9,\"r\":[\"З-009\",\"20011:АО «Гамма»\",\"20002:На экспертизе\",\"2100000\",\"12600000\",\"Проект 9: модернизация производства\",\"20068:expert1\",\"\"]},{\"i\":21006,\"u\":1,\"o\":10,\"r\":[\"З-010\",\"20005:ООО «Альфа»\",\"20003:Одобрена\",\"1500000\",\"6000000\",\"Проект 10: расширение производства\",\"20068:expert1\",\"Рекомендую к финансированию\"]},{\"i\":21014,\"u\":1,\"o\":11,\"r\":[\"З-011\",\"20005:ООО «Альфа»\",\"20003:Одобрена\",\"1000000\",\"4000000\",\"Проект 11: расширение п