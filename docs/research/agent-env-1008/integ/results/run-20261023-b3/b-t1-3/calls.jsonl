,\"type\":\"8\"},{\"num\":5,\"id\":\"283\",\"val\":\"URL_POST\",\"orig\":\"281\",\"type\":\"8\"},{\"num\":6,\"id\":\"284\",\"val\":\"URL_HEADER\",\"orig\":\"282\",\"type\":\"8\"},{\"num\":7,\"id\":\"261\",\"val\":\"FROM\",\"orig\":\"44\",\"type\":\"16\",\"arr_id\":\"44\"},{\"num\":8,\"id\":\"262\",\"val\":\"WHERE\",\"orig\":\"45\",\"type\":\"8\"},{\"num\":9,\"id\":\"263\",\"val\":\"HAVING\",\"orig\":\"260\",\"type\":\"8\"},{\"num\":10,\"id\":\"264\",\"val\":\"ORDER BY\",\"orig\":\"118\",\"type\":\"8\"},{\"num\":11,\"id\":\"134\",\"val\":\"LIMIT\",\"orig\":\"133\",\"type\":\"3\"},{\"num\":12,\"id\":\"111\",\"val\":\"Сформировать\",\"orig\":\"110\",\"type\":\"7\",\"attrs\":\"report/[ID]\"},{\"nu"}
