          "normalize": [
            "trim",
            "lower",
            "yo"
          ]
        }
      },
      "hierarchy": {
        "parent_field": "PARENT"
      },
      "fields": {
        "ID": {
          "label": "ID",
          "column": "ID Битрикс",
          "transform": "number"
        },
        "NAME": {
          "label": "Название подразделения",
          "column": "@name"
