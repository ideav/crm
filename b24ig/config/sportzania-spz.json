{
  "version": 1,
  "project": "sportzania-spz",
  "description": "Спортзания: Битрикс24 → Интеграм, учебная база spz",
  "sources": {
    "b24": {
      "type": "bitrix24",
      "portal": "b24.sportzania.ru",
      "webhook": "${B24_WEBHOOK}",
      "page_size": 50,
      "timeout_sec": 30,
      "requests_per_sec": 2,
      "retries": 3,
      "timezone": "Europe/Moscow"
    }
  },
  "target": {
    "type": "integram",
    "base_url": "https://ideav.ru",
    "db": "spz",
    "token": "${INTEGRAM_TOKEN}",
    "max_file_bytes": 7000000,
    "max_rows_per_file": 5000,
    "request_time_sec": 120
  },
  "matcher": {
    "url": "http://104.128.137.21:8077/match"
  },
  "runtime": {
    "timezone": "Europe/Moscow",
    "state_dir": "state/sportzania-spz",
    "log_dir": "logs/sportzania-spz",
    "log_keep_days": 30,
    "lock_file": "state/sportzania-spz/run.lock",
    "schedule_hint": "0 * * * *",
    "dry_run": false
  },
  "safety": {
    "on_schema_drift": "stop",
    "never_send_empty_name": true,
    "require_key": true,
    "verify_counts": true,
    "max_new_ratio_on_full_load": 0.2,
    "advance_state_only_after_upload": true
  },
  "notify": {
    "enabled": false,
    "telegram_bot_token": "${NOTIFY_TG_TOKEN}",
    "telegram_chat_id": "${NOTIFY_TG_CHAT}",
    "on": [
      "error",
      "schema_drift",
      "manual_binding_required"
    ]
  },
  "dictionaries": {
    "deal_stage": {
      "connection": "b24",
      "source": "crm.status.list",
      "entity_prefix": "DEAL_STAGE",
      "code": "STATUS_ID",
      "name": "NAME"
    },
    "lead_source": {
      "connection": "b24",
      "source": "crm.status.list",
      "entity_prefix": "SOURCE",
      "code": "STATUS_ID",
      "name": "NAME"
    },
    "lead_direction": {
      "connection": "b24",
      "source": "crm.lead.fields",
      "field": "UF_CRM_1648027063964",
      "items": "items",
      "code": "ID",
      "name": "VALUE"
    },
    "task_status": {
      "source": "static",
      "map": {
        "1": "Новая",
        "2": "Принята",
        "3": "Выполняется",
        "4": "Ждёт контроля",
        "5": "Завершена",
        "6": "Отложена",
        "7": "Отклонена"
      }
    }
  },
  "order": [
    "departments",
    "tabel",
    "bitrix_users",
    "leads",
    "deals",
    "tasks"
  ],
  "entities": {
    "departments": {
      "enabled": true,
      "source": {
        "connection": "b24",
        "method": "department.get",
        "pagination": "start",
        "result_path": "result"
      },
