# Загруженный html/svg/xml открывается на том же origin, что и все базы: его скрипт ходил бы в API
# любой базы с куками посетителя. CSP sandbox даёт такой странице отдельный (opaque) origin.
# То же правило — в docker/apache/integram.conf (там AllowOverride None, этот файл не читается).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(?i:html?|xhtml|shtml|svgz?|xml|xsl)$">
        Header always set Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads"
    </FilesMatch>

# FILE-attr uploads live in hashed subdirs download/<base>/<digits+8hex>/<nnn+8hex>.<ext>
# (index.php GetSubdir/GetFilename). There everything except raster images is served
# as attachment, and html/svg/xml additionally get a hard sandbox (no allow-scripts):
# an uploaded page must not run on the bases' origin. Mirrors docker/apache/integram.conf.
    <If "(%{REQUEST_URI} =~ m#^/download/[^/]+/[0-9]+[0-9a-f]{8}/[0-9]{3}[0-9a-f]{8}\.[^/]*$#) && (%{REQUEST_URI} !~ m#\.(?i:jpe?g|png|gif|webp|bmp|ico|avif|heic|tiff?)$#)">
        Header set Content-Disposition "attachment"
    </If>
    <If "%{REQUEST_URI} =~ m#^/download/[^/]+/[0-9]+[0-9a-f]{8}/[0-9]{3}[0-9a-f]{8}\.(?i:html?|xhtml|svg|xml)$#">
        Header set Content-Security-Policy "sandbox"
    </If>
</IfModule>
