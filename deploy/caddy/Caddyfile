# Caddy перед Apache на ideav.ru (#5573, docs/custom-domain.md).
#
# Caddy держит публичные 80/443. Apache слушает только 127.0.0.1: 8080 (HTTP) и 8443 (HTTPS) —
# Caddy ходит в него по HTTPS с исходным именем сайта (SNI + Host), поэтому для Apache, .htaccess
# и PHP соединение остаётся «HTTPS на свой сертификат»: редиректы http→https и HSTS работают как
# раньше. Адрес клиента Apache берёт из X-Forwarded-For (mod_remoteip, docs/custom-domain.md).
#
# Сайты сервера (вхосты ispmanager) — /etc/caddy/sites.caddy, собирает deploy/caddy/sites.sh:
# сертификаты ispmanager из файлов, продление — ispmanager через HTTP-01 (запрос /.well-known
# Caddy переводит на HTTPS и отдаёт Apache), после продления sites.sh + reload по таймеру.
#
# Web-socket (#5269, docs/kb/realtime.md): /ws ideav.ru и своих доменов — демону ws-server на
# 127.0.0.1:8790. Caddy держит соединение сам, процесс Apache оно не занимает.
#
# Чужие домены клиентов — блок https:// в конце: сертификат Let's Encrypt выпускается при первом
# заходе, если ядро ответит 200 на /my/_domain_ok?domain=<хост>.

{
	email care@ideav.ru
	on_demand_tls {
		ask http://127.0.0.1:9180/my/_domain_ok
	}
}

# В Apache по HTTPS с именем сайта; заголовки своего домена с клиента не принимаются.
(apache) {
	# Защитные заголовки ideav.ru на всех путях (python2node#1142): .htaccess вебрута (backlogram#893)
	# до /my/ и ядра не доходит. «?» — только если Apache их не прислал; HSTS — всегда год,
	# без includeSubDomains (поддомены сервера бывают только на HTTP).
	@ideav host ideav.ru www.ideav.ru
	header @ideav {
		defer
		Strict-Transport-Security "max-age=31536000"
		?X-Frame-Options SAMEORIGIN
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		?Content-Security-Policy "frame-ancestors 'self' https://webvisor.com https://*.webvisor.com https://metrika.yandex.ru https://*.metrika.yandex.ru"
		# Скрипты и стили — пока только отчёты (python2node#1421): браузер ничего не блокирует, нарушения
		# шлёт на /_csp-report. 'unsafe-inline' нет намеренно: inline-скрипты и стили должны попасть в отчёты.
		Content-Security-Policy-Report-Only "script-src 'self' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://smartcaptcha.yandexcloud.net https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://ajax.googleapis.com https://code.jquery.com; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://maxcdn.bootstrapcdn.com https://stackpath.bootstrapcdn.com https://code.jquery.com; report-uri /_csp-report"
	}
	# Отчёты CSP — в журнал Caddy /var/log/caddy/csp-report.log, по строке JSON на отчёт (поле csp_report),
	# в Apache не идут. Тело обрезается до 8 КБ, журнал крутится по 10 МБ × 5. Остальные запросы
	# в этот журнал не пишутся (log_skip), в journald отчёты не дублируются.
	@csp_report {
		host ideav.ru www.ideav.ru
		path /_csp-report
		method POST
	}
	@not_csp_report not {
		host ideav.ru www.ideav.ru
		path /_csp-report
		method POST
	}
	log csp_report {
		output file /var/log/caddy/csp-report.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	log_skip @not_csp_report
	handle @csp_report {
		request_body {
			max_size 8KB
		}
		log_append csp_report {http.request.body}
		respond 204
	}
	@ws {
		host ideav.ru www.ideav.ru
		path /ws
	}
	handle @ws {
		reverse_proxy 127.0.0.1:8790
	}
	handle {
		reverse_proxy https://127.0.0.1:8443 {
			header_up -X-Integram-Domain
			header_up -X-Integram-Edge
			transport http {
				tls_server_name {http.request.host}
				tls_insecure_skip_verify
			}
		}
	}
}
(apache_http) {
	reverse_proxy 127.0.0.1:8080 {
		header_up -X-Integram-Domain
		header_up -X-Integram-Edge
	}
}

# Проверка on-demand TLS: Caddy спрашивает сам себя, отсюда — в ядро ideav.ru.
http://127.0.0.1:9180 {
	bind 127.0.0.1
	reverse_proxy https://127.0.0.1:8443 {
		header_up Host ideav.ru
		transport http {
			tls_server_name ideav.ru
			tls_insecure_skip_verify
		}
	}
}

import /etc/caddy/sites.caddy

# Свои домены клиентов.
https:// {
	tls {
		on_demand
	}
	handle /ws {
		reverse_proxy 127.0.0.1:8790
	}
	handle {
		rewrite / /_root
		reverse_proxy https://127.0.0.1:8443 {
			header_up Host ideav.ru
			header_up X-Integram-Domain {host}
			header_up X-Integram-Edge {$INTEGRAM_EDGE_SECRET}
			transport http {
				tls_server_name ideav.ru
				tls_insecure_skip_verify
			}
		}
	}
}

# HTTP чужих доменов — на HTTPS (у сайтов сервера редирект свой, от автоматического HTTPS Caddy).
http:// {
	redir https://{host}{uri} 308
}
